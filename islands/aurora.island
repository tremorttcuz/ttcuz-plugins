{
  "island": 1,
  "name": "Аврора",
  "author": "ttcuz",
  "bar": {
    "height": 60,
    "radius": 30,
    "backdrop": true,
    "fill": "#99101820",
    "effect": [
      "uniform shader content;",
      "uniform float2 size;",
      "uniform float time;",
      "uniform half4 accent;",
      "half4 main(float2 p) {",
      "  half4 c = content.eval(p);",
      "  float band = 0.5 + 0.5 * sin(p.x / size.x * 6.2832 * 1.5 + time * 0.8);",
      "  float fade = 1.0 - smoothstep(0.0, size.y, p.y);",
      "  half3 glow = mix(accent.rgb, half3(0.3, 1.0, 0.7), half(band));",
      "  c.rgb += glow * half(0.18 * fade) * c.a;",
      "  return c;",
      "}"
    ]
  },
  "buttons": {
    "color": "#B3FFFFFF",
    "selectedColor": "#FFFFFFFF",
    "labels": "selected",
    "labelSize": 10,
    "y": 0.42
  },
  "indicator": { "shape": "none" },
  "create": { "shape": "sunny", "size": 42, "spin": 60 },
  "motion": { "duration": 300, "easing": "smooth" }
}
