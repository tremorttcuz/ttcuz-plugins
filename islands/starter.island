{
  "island": 1,
  "name": "Мой островок",
  "author": "@me",
  "version": "1.0",
  "bar": {
    "height": 60,
    "side": 12,
    "lift": 6,
    "radius": 30,
    "backdrop": true,
    "fill": "card 72%",
    "stroke": "text 8%",
    "strokeWidth": 1,
    "shadow": "#40000000",
    "shadowRadius": 14,
    "shadowY": 4
  },
  "buttons": {
    "order": ["home", "friends", "create", "inbox", "profile"],
    "y": 0.5,
    "size": 24,
    "color": "muted",
    "selectedColor": "on accent",
    "filledWhenSelected": true,
    "labels": "beside",
    "labelSize": 13,
    "selectedLabelColor": "on accent"
  },
  "indicator": {
    "shape": "pill",
    "width": 56,
    "height": 40,
    "color": "accent",
    "stretch": 0.35
  },
  "create": {
    "shape": "sunny",
    "size": 44,
    "color": "accent",
    "plusColor": "on accent",
    "spin": 45
  },
  "motion": {
    "duration": 360,
    "easing": "spring"
  }
}
